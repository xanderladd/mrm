{
  "experiment": {
    "name": "ibl_pca_analysis",
    "session_id": "6f36868f-5cc1-450c-82fa-6b9829ce0cfe",
    "description": "PCA analysis of IBL session neural data with mean trajectories"
  },
  "dataset": {
    "type": "ibl", 
    "params": {
      "eid": "6f36868f-5cc1-450c-82fa-6b9829ce0cfe",
      "probe_selection": ["alf/probe01/pykilosort"],
      "alignment_event": "stimOn_times",
      "pre_time": 0.1,
      "post_time": 0.2,
      "bin_size": 0.005,
      "min_trial_length": 0.3,
      "val_fraction": 0.1,
      "test_fraction": 0.2,
      "random_seed": 42,
      "use_cache": true,
      "brain_regions": ["CP"],
      "unit_quality_thresh": 0.5
    }
  },
  "model": {
    "type": "pca",
    "params": {
      "n_components": 32,
      "fit_method": null

    }
  },
  "save_dir": "D:/multi_region/outputs",
  "analysis": {
    "extract_latents": true,
    "behavioral_decoding": true,
    "dimensionality_analysis": true,
    "trajectory_visualization": true,
    "reconstruction_quality": true,
    "split_by_behavior": {
      "choice": [-1, 1],
      "feedback_type": [-1, 1],
      "stimulus_contrast": [0, 0.25, 0.5, 1.0],
      "stimulus_position": ["left", "right", "no_stim"],  
      "reaction_time_tertiles": true
    }
  },
  "visualization": {
    "latent_dims_to_plot": [0, 1, 2, 3, 4],
    "max_trials_trajectory": 15,
    "time_window": [-0.1, 0.3],
    "acausal_smoothing": true,
    "temporal_smoothing": 2,
    "behavioral_signals": [
      "choice",
      "feedback_type", 
      "stimulus_contrast_left",
      "stimulus_contrast_right",
      "stimulus_position",  
      "reaction_time"
    ],
    "trajectory_plots": {
      "show_start_end_markers": true,
      "show_velocity_vectors": false,
      "color_by_time": false,
      "separate_subplots_by_condition": true,
      "group_by_stimulus_position": true  
    },
    "comparison_plots": {
      "choice_vs_stimulus_position": true,  
      "sensory_vs_decision_dynamics": true  
    }
  }
}
